# ============================================================
# basil-ai / .env.example
# 実運用では basil-ai/.env にコピーして値を埋める。.env は commit 禁止。
# ============================================================

# --- Claude API ---
ANTHROPIC_API_KEY=
# 使用モデル。2026-04 時点の最新最上位は claude-opus-4-7。
# 撮影時に映る「判断をしているモデル」なので明示しておく。
ANTHROPIC_MODEL=claude-opus-4-7

# --- LINE Messaging API (LINE Notify は終了済み、使わない) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# --- MQTT (Pi 上の Mosquitto / ローカル) ---
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=basil-pi

# --- Camera ---
# /dev/video0 等。複数カメラがあるときはシリアル指定を優先する
CAMERA_DEVICE=/dev/video0
CAPTURE_DIR=./captures

# --- DB ---
DB_PATH=./basil.db

# --- Logging ---
LOG_DIR=./logs
LOG_LEVEL=INFO

# --- 判定スケジュール ---
# 1 日の定時観察タイミング(HH:MM, カンマ区切り)。2〜4 回を推奨。
OBSERVATION_TIMES=07:00,12:00,18:00

# --- セーフティガード(詳細は docs/safety-guards.md) ---
MAX_WATER_ML_PER_SHOT=40
MIN_COOLDOWN_MINUTES=180
TANK_EMPTY_SHUTDOWN=1
